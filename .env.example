DEBUG=false
ALLOW_INSECURE_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-random-48-char-secret-before-production

# Shared Basic Auth — temporary until SSO. One login for all operators.
# No roles, session revocation, or per-user accounts.
AUTH_USERNAME=admin
AUTH_PASSWORD=replace-with-strong-password
AUTH_LOCKOUT_ATTEMPTS=5
AUTH_LOCKOUT_WINDOW_SECONDS=300

MAX_UPLOAD_BYTES=52428800
UPLOAD_RATE_LIMIT_PER_MINUTE=10
MAX_UPLOAD_STORAGE_BYTES=1073741824
MAX_UPLOAD_FILES=100

XLSX_MAX_ARCHIVE_ENTRIES=20000
XLSX_MAX_UNCOMPRESSED_BYTES=262144000
XLSX_MAX_COMPRESSION_RATIO=100
XLSX_MAX_SHEETS=50
XLSX_MAX_ROWS_PER_SHEET=100000
XLSX_VALIDATION_TIMEOUT_SECONDS=30

# Leave empty in production compose: backend is on an internal Docker network.
# Rate-limit uses nginx X-Real-IP ($remote_addr), not client X-Forwarded-For.
TRUSTED_PROXY_IPS=
ALLOWED_HOSTS=dashboard.example.internal,localhost,127.0.0.1
SERVER_NAME=dashboard.example.internal
MONITORING_CIDR=10.0.0.0/8

DATA_DIR=data
UPLOADS_DIR=uploads
DATABASE_PATH=runtime/dashboard.sqlite3
LOGS_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
ACTIVE_DEFAULT_FILE=data.xlsx
